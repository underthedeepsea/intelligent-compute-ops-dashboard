# Copy to .env; never commit real secrets. Public access must be through TLS ingress.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
PGPASSWORD=replace-with-a-long-random-database-password
ALLOWED_HOSTS=localhost,127.0.0.1,control.example.internal
CSRF_TRUSTED_ORIGINS=https://control.example.internal
INSPECTION_ALLOWED_URLS=
# Add a server secret env variable whose NAME is Provider.credential_ref when authorized.
