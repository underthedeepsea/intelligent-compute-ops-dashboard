# Copy to .env, substitute all placeholders. Never commit real secrets.
IMAGE_REGISTRY=registry.example.invalid/control
IMAGE_VERSION=0.4.0
DJANGO_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET
PGPASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
ALLOWED_HOSTS=localhost,127.0.0.1,control.example.internal
CSRF_TRUSTED_ORIGINS=https://control.example.internal
INSPECTION_ALLOWED_URLS=
# Do not enable CONTROL_LOCAL or CONTROL_PASSWORDLESS_LOCAL in deployment.
# Inspection credentials require separate explicit authorized integration.
