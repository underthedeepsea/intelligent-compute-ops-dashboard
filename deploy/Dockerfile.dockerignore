# Allow only production code, static assets and CSV templates into the context.
**
!requirements.lock
!backend/
!backend/**
!frontend/
!frontend/**
!templates/
!templates/*.csv
!deploy/
!deploy/Dockerfile
!deploy/entrypoint.sh
!deploy/nginx.conf
**/__pycache__/**
**/*.pyc
**/tests/**
**/.env*
**/*.sqlite*
**/*.db
**/*.db-*
**/*-journal
**/*-wal
**/*-shm
**/*.pem
**/*.key
**/.DS_Store
backend/staticfiles/**
